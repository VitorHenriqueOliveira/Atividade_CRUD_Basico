<h1>Editar Materia</h1>
<form action="/materias/edit/<%= materia.id %>" method="POST">
    <div class="form-group">
        <label for="nome">Materia</label>
        <input type="text" class="form-control" id="nome" name="nome" value="<%= materia.nome %>" required>
    </div>
    <div class="form-group">
        <label for="professor">Professor</label>
        <select class="form-control" id="professor" name="professorId" required>
            <% professores.forEach(professor => { %>
            <option value="<%= professor.id %>" <%=professor.id === materia.professorId ? 'selected' : '' %>>
                <%= professor.nome %>
            </option>
            <% }) %>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Atualizar</button>
</form>